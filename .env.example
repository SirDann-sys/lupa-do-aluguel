# Copie para .env e preencha. Nenhuma chave é obrigatória:
# sem chaves, a análise usa só o extrator heurístico (menos preciso).
LUPA_GROQ_API_KEY=
LUPA_GEMINI_API_KEY=

# Banco: sem configuração, usa SQLite local. Em produção (Render), a URL do
# PostgreSQL (Neon) vem de LUPA_DATABASE_URL ou DATABASE_URL; a conexão direta
# para migrações, de DATABASE_URL_UNPOOLED. O app também lê .env.local.
# LUPA_DATABASE_URL=postgresql://usuario:senha@host/banco
