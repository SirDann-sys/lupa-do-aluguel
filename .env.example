# Copie para .env e preencha. Nenhuma chave é obrigatória:
# sem chaves, a análise usa só o extrator heurístico (menos preciso).
LUPA_GROQ_API_KEY=
LUPA_GEMINI_API_KEY=

# Banco: `neon init` grava DATABASE_URL e DATABASE_URL_UNPOOLED em .env.local,
# e o app lê os dois. Para outro PostgreSQL, use LUPA_DATABASE_URL.
# LUPA_DATABASE_URL=postgresql://usuario:senha@host/banco
